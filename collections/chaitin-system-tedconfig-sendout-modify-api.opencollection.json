{
  "opencollection": "1.0.0",
  "info": {
    "name": "APISec Management account system/tedconfig/sendout/modify API",
    "version": "26.05"
  },
  "items": [
    {
      "info": {
        "name": "system/tedconfig/sendout/modify",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "TED外发文件配置修改",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/system/tedconfig/sendout/modify",
            "headers": [
              {
                "name": "X-CS-Header-App",
                "value": "{{app}}"
              },
              {
                "name": "X-CS-Header-Company",
                "value": "{{company_id}}"
              },
              {
                "name": "X-CS-Header-Crypt",
                "value": ""
              },
              {
                "name": "If-None-Match",
                "value": "string"
              },
              {
                "name": "X-CS-Header-Debug",
                "value": "{{debug}}"
              },
              {
                "name": "Accept-Language",
                "value": "zh"
              },
              {
                "name": "X-Cs-Header-Timezone",
                "value": "Asia/Shanghai"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "TED外发文件配置修改"
        }
      ]
    }
  ],
  "bundled": true
}