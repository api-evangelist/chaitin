{
  "opencollection": "1.0.0",
  "info": {
    "name": "APISec Management account device/{device_id}/diagnosistask/{task_id}/getfilemetadata API",
    "version": "26.05"
  },
  "items": [
    {
      "info": {
        "name": "device/{device_id}/diagnosistask/{task_id}/getfilemetadata",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "下载诊断文件",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/device/:device_id/diagnosistask/:task_id/getfilemetadata",
            "headers": [
              {
                "name": "X-CS-Header-App",
                "value": "{{app}}"
              },
              {
                "name": "X-CS-Header-Company",
                "value": "{{company_id}}"
              },
              {
                "name": "X-CS-Header-Crypt",
                "value": ""
              },
              {
                "name": "If-None-Match",
                "value": "string"
              },
              {
                "name": "X-CS-Header-Debug",
                "value": "{{debug}}"
              },
              {
                "name": "Accept-Language",
                "value": "zh"
              },
              {
                "name": "X-Cs-Header-Timezone",
                "value": "Asia/Shanghai"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "params": [
              {
                "name": "device_id",
                "value": "string",
                "type": "path"
              },
              {
                "name": "task_id",
                "value": "string",
                "type": "path"
              }
            ]
          },
          "docs": "下载诊断文件"
        }
      ]
    }
  ],
  "bundled": true
}