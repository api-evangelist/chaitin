{
  "opencollection": "1.0.0",
  "info": {
    "name": "APISec Management account system/commonstatusdeviceconfig/retrieve API",
    "version": "26.05"
  },
  "items": [
    {
      "info": {
        "name": "system/commonstatusdeviceconfig/retrieve",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "终端配置 - 浏览器深度管控查询",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/system/commonstatusdeviceconfig/retrieve",
            "headers": [
              {
                "name": "X-CS-Header-App",
                "value": "{{app}}"
              },
              {
                "name": "X-CS-Header-Company",
                "value": "{{company_id}}"
              },
              {
                "name": "X-CS-Header-Crypt",
                "value": ""
              },
              {
                "name": "If-None-Match",
                "value": "string"
              },
              {
                "name": "X-CS-Header-Debug",
                "value": "{{debug}}"
              },
              {
                "name": "Accept-Language",
                "value": "zh"
              },
              {
                "name": "X-Cs-Header-Timezone",
                "value": "Asia/Shanghai"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ]
          },
          "docs": "终端配置 - 浏览器深度管控查询"
        }
      ]
    }
  ],
  "bundled": true
}