{
  "opencollection": "1.0.0",
  "info": {
    "name": "APISec Management account policy/realtime_monitor/{policy_id}/action API",
    "version": "26.05"
  },
  "items": [
    {
      "info": {
        "name": "policy/realtime_monitor/{policy_id}/action",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "实时监控修改策略状态",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/policy/realtime_monitor/:policy_id/action",
            "headers": [
              {
                "name": "X-CS-Header-App",
                "value": "{{app}}"
              },
              {
                "name": "X-CS-Header-Company",
                "value": "{{company_id}}"
              },
              {
                "name": "X-CS-Header-Crypt",
                "value": ""
              },
              {
                "name": "If-None-Match",
                "value": "string"
              },
              {
                "name": "X-CS-Header-Debug",
                "value": "{{debug}}"
              },
              {
                "name": "Accept-Language",
                "value": "zh"
              },
              {
                "name": "X-Cs-Header-Timezone",
                "value": "Asia/Shanghai"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "params": [
              {
                "name": "policy_id",
                "value": "string",
                "type": "path"
              },
              {
                "name": "operation",
                "value": "activate",
                "type": "query"
              }
            ]
          },
          "docs": "实时监控修改策略状态"
        }
      ]
    }
  ],
  "bundled": true
}