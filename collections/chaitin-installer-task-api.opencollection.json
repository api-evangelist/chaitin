{
  "opencollection": "1.0.0",
  "info": {
    "name": "APISec Management account installer/task API",
    "version": "26.05"
  },
  "items": [
    {
      "info": {
        "name": "installer/task",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "发布版本并创建任务",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/installer/task/",
            "headers": [
              {
                "name": "X-CS-Header-App",
                "value": "{{app}}"
              },
              {
                "name": "X-CS-Header-Company",
                "value": "{{company_id}}"
              },
              {
                "name": "X-CS-Header-Crypt",
                "value": ""
              },
              {
                "name": "If-None-Match",
                "value": "string"
              },
              {
                "name": "X-CS-Header-Debug",
                "value": "{{debug}}"
              },
              {
                "name": "Accept-Language",
                "value": "zh"
              },
              {
                "name": "X-Cs-Header-Timezone",
                "value": "Asia/Shanghai"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "发布版本并创建任务"
        }
      ]
    }
  ],
  "bundled": true
}