{
  "opencollection": "1.0.0",
  "info": {
    "name": "APISec Management account statistic/{device_id}/disk API",
    "version": "26.05"
  },
  "items": [
    {
      "info": {
        "name": "statistic/{device_id}/disk",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "终端硬盘",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/statistic/:device_id/disk",
            "headers": [
              {
                "name": "X-CS-Header-App",
                "value": "{{app}}"
              },
              {
                "name": "X-CS-Header-Company",
                "value": "{{company_id}}"
              },
              {
                "name": "X-CS-Header-Crypt",
                "value": ""
              },
              {
                "name": "If-None-Match",
                "value": "string"
              },
              {
                "name": "X-CS-Header-Debug",
                "value": "{{debug}}"
              },
              {
                "name": "Accept-Language",
                "value": "zh"
              },
              {
                "name": "X-Cs-Header-Timezone",
                "value": "Asia/Shanghai"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "params": [
              {
                "name": "device_id",
                "value": "a531ef8a-c817-41e6-875b-e70da1cd9963",
                "type": "path"
              }
            ]
          },
          "docs": "终端硬盘"
        }
      ]
    }
  ],
  "bundled": true
}